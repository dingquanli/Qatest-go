# Qatest-Go 环境配置示例
# 复制此文件为 .env 并根据需要修改

# 服务端口
PORT=3000

# SQLite 数据库路径
DB_PATH=qatest.db

# JWT 配置
# ⚠ 必填：不能为空、也不能使用此默认占位值，否则服务拒绝启动。
# 生成方式示例：openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_string
JWT_EXPIRES_IN=24h

# CORS 允许源（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000

# 日志级别：DEBUG/INFO/WARN/ERROR
LOG_LEVEL=INFO

# gRPC 代理默认目标
PROXY_TARGET=

# Proto 文件目录
PROTO_DIR=

# 日志监听目录
LOG_DIR=logs

# ⚠ 必填：管理员 admin 的登录口令（明文，程序启动时自动 bcrypt 哈希）。
# 未设置此项服务将拒绝启动。请使用足够强度的口令。
ADMIN_PASSWORD=change_me_to_a_strong_password

# 用户列表（JSON 数组，每项含 username/passwordHash/name/role）
# 默认 admin 密码 admin123，tester 密码 test123
# ⚠ 生产环境务必修改默认密码！建议使用 bcrypt 生成强密码 hash
QATEST_USERS=[{"username":"admin","passwordHash":"$2a$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy","name":"管理员","role":"admin"},{"username":"tester","passwordHash":"$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX","name":"测试员","role":"tester"}]

# P0-4: JS 脚本执行时使用的 JWT token（adb() 函数调用需要认证）
# 留空则 JS 脚本中的 adb() 调用会返回 401
JS_AUTH_TOKEN=
